# Nidalplayer Environment Variables Template
# Copy this file to .env for local development

# (Optional) The Movie Database (TMDB) v3 API Key for metadata & poster enrichment
# Users can also configure this directly in the app: Settings > Playback & Performance Config
TMDB_API_KEY=

# (Optional) Port for companion mobile remote control over local network (Default: 8080)
# STREAMLINE_REMOTE_PORT=8080
