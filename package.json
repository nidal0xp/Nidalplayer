{
  "name": "nidalplayer",
  "version": "4.0.0",
  "description": "Nidalplayer — M3U Media Player for M3U playlists and Xtream Codes",
  "main": "main.js",
  "author": "Nidalplayer",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "tv": "electron . --tv",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:setup": "electron-builder --win nsis --x64",
    "android:tv": "python scripts/pack_apk.py",
    "android:all": "python scripts/pack_apk.py",
    "android:dist": "python scripts/pack_apk.py",
    "tizen:pack": "python scripts/pack_tizen.py",
    "postdist": "powershell -Command \"Copy-Item 'apk/*' -Destination 'dist' -Force -ErrorAction SilentlyContinue; Copy-Item 'tizen/*' -Destination 'dist' -Recurse -Force -ErrorAction SilentlyContinue\"",
    "release": "electron-builder --win --publish always",
    "test": "node --test tests/core.test.mjs"
  },
  "dependencies": {
    "artplayer": "^5.1.7",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.5.17",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nidalplayer.app",
    "productName": "Nidalplayer",
    "asar": true,
    "directories": {
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "nidal0xp",
      "repo": "Nidalplayer",
      "private": true
    },
    "files": [
      "index.html",
      "privacy.html",
      "styles.css",
      "main.js",
      "preload.js",
      "src/**/*",
      "remote/**/*",
      "tv/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/*/{test,__tests__,docs,example,examples}/**/*",
      "!tests/**/*",
      "!scripts/**/*",
      "!*.exe",
      "!dist/**/*",
      "!**/*.map",
      "!**/.cache/**/*"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "displayLanguageSelector": false,
      "installerLanguages": [
        "en",
        "ar",
        "fr",
        "es",
        "de"
      ],
      "include": "build/installer.nsh",
      "uninstallDisplayName": "Nidalplayer Media Player",
      "menuCategory": "Nidalplayer",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nidalplayer",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Nidalplayer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Nidalplayer-Portable.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
